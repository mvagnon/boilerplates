{
  "name": "@boilerplates/rn",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run web",
    "api:sync": "orval",
    "pull": "bunx eas-cli env:pull --environment development --path .env.local",
    "pull:preview": "bunx eas-cli env:pull --environment preview --path .env.local",
    "prebuild": "expo prebuild --clean",
    "ios": "expo run:ios --device --no-bundler",
    "android": "expo run:android --device --no-bundler",
    "web": "expo start --web",
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "staticchecks": "bun run lint && bun run typecheck && bun run knip",
    "preview": "bunx eas-cli build --platform all --profile preview --auto-submit",
    "preview:android": "bunx eas-cli build --platform android --profile preview",
    "preview:ios": "bunx eas-cli build --platform ios --profile preview --auto-submit",
    "prod": "bunx eas-cli build --platform all --profile production --auto-submit",
    "prod:android": "bunx eas-cli build --platform android --profile production",
    "prod:ios": "bunx eas-cli build --platform ios --profile production --auto-submit",
    "update": "bunx eas-cli update --channel production --environment production"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bootsplash": "7.3.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/json": "^2.0.0",
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "ajv": "^8",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "expo-mcp": "~0.2.1",
    "knip": "^6.38.0",
    "orval": "^8.46.0",
    "typescript": "~6.0.3"
  },
  "private": true
}

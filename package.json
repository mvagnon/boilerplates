{
  "name": "boilerplates",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter=@boilerplates/react",
    "dev:rn": "turbo run dev --filter=@boilerplates/rn",
    "staticchecks": "turbo run lint typecheck knip",
    "build": "turbo run build"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "pretty-quick": "^4.2.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10"
  }
}

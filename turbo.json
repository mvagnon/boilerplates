{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_*"],
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "EXPO_*", "REACT_NATIVE_*"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {},
    "@boilerplates/react#typecheck": {
      "outputs": [".react-router/types/**"]
    },
    "knip": {
      "dependsOn": ["typecheck"]
    },
    "api:sync": {
      "cache": false,
      "env": ["OPENAPI_URL"]
    }
  }
}
